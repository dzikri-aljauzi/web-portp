# ---- Admin dashboard (/admin) ------------------------------------------
# PostgreSQL connection string. Without it the site shows its built-in
# content and the admin cannot save changes. A free Neon database works.
DATABASE_URL=
# Optional: direct (non-pooled) connection used for migrations.
# Neon's Vercel integration sets this automatically.
DATABASE_URL_UNPOOLED=

# Password for /admin/login. At least 12 characters.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. At least 32 characters.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=

# ---- AI assistant (optional) -------------------------------------------
# Enables Claude for the chat widget. Without it the widget still works,
# answering from the site content.
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5)
ANTHROPIC_MODEL=
