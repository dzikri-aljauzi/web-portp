// Database schema for the portfolio CMS.
// After editing: npx prisma migrate dev --name <change>

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Singleton-style content documents (e.g. "profile", "skills"), validated with Zod in the app.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  tagline     String   @default("")
  year        String   @default("")
  category    String   @default("web")
  role        String   @default("")
  status      String   @default("completed")
  duration    String   @default("")
  description String   @default("")
  overview    String   @default("")
  problem     String   @default("")
  solution    String   @default("")
  learnings   String   @default("")
  points      String[]
  stack       String[]
  features    Json     @default("[]")
  metrics     Json     @default("[]")
  gallery     Json     @default("[]")
  coverImage  String   @default("")
  preview     String   @default("certify")
  liveUrl     String   @default("")
  repoUrl     String   @default("")
  featured    Boolean  @default(true)
  published   Boolean  @default(true)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Experience {
  id             String   @id @default(cuid())
  role           String
  company        String
  type           String   @default("")
  location       String   @default("")
  period         String   @default("")
  summary        String   @default("")
  highlightValue String   @default("")
  highlightLabel String   @default("")
  points         String[]
  tags           String[]
  published      Boolean  @default(true)
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Uploaded files (images, CV) stored in the database and served from /api/media/[id].
model Media {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())
}
